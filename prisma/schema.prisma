generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Result {
  win
  loss
}

enum Perspective {
  survivor
  killer
}

enum StreakStatus {
  active
  ended
}

enum CrewMemberStatus {
  pending
  accepted
  declined
}

enum CrewWritePolicy {
  hostOnly
  allMembers
}

model User {
  id            String      @id @default(cuid())
  email         String      @unique
  name          String?
  password      String
  // Set on every successful password reset. A JWT issued before this instant
  // is treated as stale (see the `jwt` callback in src/auth.ts) — this is what
  // forces every other open session to log in again after a reset.
  passwordChangedAt DateTime?
  preferredMode Perspective @default(survivor)
  // Season intent, not a season id: "current" | "all" | "<n>". Storing the
  // intent means a preference saved during one season still opens the *new*
  // current season after a rollover instead of pinning a finished one.
  preferredSeason String    @default("current")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  players   Player[]
  teams     Team[]
  matches   Match[]
  streaks   StreakRun[]
  profile   Profile?
  passwordResetTokens PasswordResetToken[]

  crewsOwned         Crew[]       @relation("CrewOwner")
  crewMemberships    CrewMember[]
  crewMatchesLogged  CrewMatch[]  @relation("CrewMatchLogger")
}

// A single-use, time-limited token for the "forgot password" flow. Only the
// sha256 hash of the raw token is ever stored — see src/lib/password-reset.ts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Killer {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  imageUrl  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  matches   Match[]
  profiles  Profile[]
  crewMatches CrewMatch[]
}

model Survivor {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  imageUrl  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  profiles  Profile[]
}

// A user's public community profile. The existence of this row means the user
// opted in to being publicly discoverable (carousel + community tab). Only
// whitelisted fields are ever exposed publicly — never email/password.
model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  nick         String
  channelUrl   String?
  mainKillerId Int?
  mainSurvId   Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mainKiller   Killer?   @relation(fields: [mainKillerId], references: [id], onDelete: SetNull)
  mainSurv     Survivor? @relation(fields: [mainSurvId], references: [id], onDelete: SetNull)

  @@index([mainKillerId])
  @@index([mainSurvId])
}

model Player {
  id        Int          @id @default(autoincrement())
  userId    String
  name      String
  nick      String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  teams     TeamPlayer[]

  @@unique([userId, nick])
  @@index([userId])
}

model Team {
  id        Int          @id @default(autoincrement())
  userId    String
  name      String
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  members   TeamPlayer[]
  matches   Match[]
  streaks   StreakRun[]

  @@unique([userId, name])
  @@index([userId])
}

model TeamPlayer {
  teamId   Int
  playerId Int
  team     Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@id([teamId, playerId])
  @@index([playerId])
}

model Match {
  id          Int         @id @default(autoincrement())
  userId      String?
  killerId    Int
  teamId      Int?
  streakRunId Int?
  crewMatchId Int?
  result      Result
  perspective Perspective @default(survivor)
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  killer      Killer      @relation(fields: [killerId], references: [id], onDelete: Cascade)
  team        Team?       @relation(fields: [teamId], references: [id], onDelete: SetNull)
  streakRun   StreakRun?  @relation(fields: [streakRunId], references: [id], onDelete: SetNull)
  crewMatch   CrewMatch?  @relation(fields: [crewMatchId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([killerId])
  @@index([teamId])
  @@index([crewMatchId])
  @@index([createdAt])
  @@index([userId, perspective])
  @@index([killerId, perspective])
  // Season-scoped reads all filter on this triple (grid, history, community).
  @@index([userId, perspective, createdAt])
}

model StreakRun {
  id        Int          @id @default(autoincrement())
  userId    String
  teamId    Int
  winCount  Int          @default(0)
  status    StreakStatus @default(active)
  startedAt DateTime     @default(now())
  endedAt   DateTime?
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  team      Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  matches   Match[]

  @@index([userId])
  @@index([teamId])
}

// A collaborative crew: a real-user team that shares one streak. The owner is an
// auto-accepted member; up to 3 others are invited (CrewMember rows). A logged
// match is one CrewMatch (source of truth for the shared streak) fanned out to
// one personal Match per accepted member so it also feeds each member's stats.
model Crew {
  id          Int             @id @default(autoincrement())
  name        String
  ownerId     String
  writePolicy CrewWritePolicy @default(allMembers)
  createdAt   DateTime        @default(now())
  owner       User            @relation("CrewOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     CrewMember[]
  matches     CrewMatch[]
  streaks     CrewStreakRun[]

  @@unique([ownerId, name])
  @@index([ownerId])
}

model CrewMember {
  id          Int              @id @default(autoincrement())
  crewId      Int
  userId      String
  status      CrewMemberStatus @default(pending)
  isOwner     Boolean          @default(false)
  invitedAt   DateTime         @default(now())
  respondedAt DateTime?
  crew        Crew             @relation(fields: [crewId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([crewId, userId])
  @@index([userId, status])
  @@index([crewId])
}

model CrewMatch {
  id              Int            @id @default(autoincrement())
  crewId          Int
  killerId        Int
  result          Result
  loggedByUserId  String
  crewStreakRunId Int?
  createdAt       DateTime       @default(now())
  crew            Crew           @relation(fields: [crewId], references: [id], onDelete: Cascade)
  killer          Killer         @relation(fields: [killerId], references: [id], onDelete: Cascade)
  loggedBy        User           @relation("CrewMatchLogger", fields: [loggedByUserId], references: [id], onDelete: Cascade)
  streakRun       CrewStreakRun? @relation(fields: [crewStreakRunId], references: [id], onDelete: SetNull)
  projections     Match[]

  @@index([crewId])
  @@index([createdAt])
}

model CrewStreakRun {
  id        Int          @id @default(autoincrement())
  crewId    Int
  winCount  Int          @default(0)
  status    StreakStatus @default(active)
  startedAt DateTime     @default(now())
  endedAt   DateTime?
  crew      Crew         @relation(fields: [crewId], references: [id], onDelete: Cascade)
  matches   CrewMatch[]

  @@index([crewId])
}
