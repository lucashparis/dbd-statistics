# ============================================================
# DBD Killer Tracker — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit your actual .env file to version control.
# ============================================================

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/dbd_statistics"
# Direct (non-pooled) connection used by Prisma Migrate / db push
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/dbd_statistics"

# Auth.js secret — generate with: npx auth secret
AUTH_SECRET="replace-me"

# Password for the default seeded account
SEED_DEFAULT_PASSWORD="changeme"

# Rate limiting (Upstash Redis REST) — OPTIONAL.
# Required for real rate limiting on serverless (in-memory doesn't work there).
# When unset, rate limiting is disabled and all requests pass through (fail-open).
# Create a free database at https://console.upstash.com and copy the REST creds.
NEXT_PUBLIC_SEASONS_ENABLED="true"   # optional — set to "false" to disable season scoping (everything reads all-time)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Collaborative crews (invite-based shared streaks) — OPTIONAL.
# Default: enabled. Set to "false" to fall back to the legacy single-user
# team/streak UI without a schema change.
NEXT_PUBLIC_CREWS_ENABLED="true"

# Killer mode (Survivor/Killer perspective toggle) — OPTIONAL.
# Default: enabled. Set to "false" to hide the toggle and run the app
# survivor-only (a UI rollback with no schema change).
NEXT_PUBLIC_KILLER_MODE_ENABLED="true"

# Password reset — REQUIRED for the "forgot password" flow.
# SMTP credentials used to send the reset link (src/lib/mailer.ts).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="DBD Statistics <no-reply@example.com>"

# Public base URL of the app — used to build the absolute reset-password link
# sent by email. Server-only (not NEXT_PUBLIC_*): never read in the browser.
APP_URL="http://localhost:3000"
